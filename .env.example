# ==========================================
# Memory MCP Configuration Template
# ==========================================

# Directory where SurrealDB and model cache will be stored
DATA_DIR=./data

# Model selection. granite is the default (Apache 2.0; no authentication required).
# Options: granite, e5_multi, e5_small, qwen3, gemma, bge_m3, nomic
EMBEDDING_MODEL=granite

# Matryoshka Representation Learning (MRL) dimension.
# Leave commented out to use the model's native maximum dimension (e.g. 1024 for Qwen3).
# MRL_DIM=512

# Hugging Face Access Token
# REQUIRED ONLY if you use a "Gated Model" like 'gemma'. 
# To use Gemma: 
# 1. Accept license at https://huggingface.co/google/embeddinggemma-300m
# 2. Get token at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# Inference settings
BATCH_SIZE=8
CACHE_SIZE=1000

# Logging verbosity (trace, debug, info, warn, error)
LOG_LEVEL=info
