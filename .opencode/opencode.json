{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "memory-mcp-dev-stdio": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "--init",
                "--rm",
                "-i",
                "--name",
                "memory-mcp-dev-stdio",
                "-v",
                "memory-mcp-data-dev:/data",
                "-v",
                "/home/unnamed/project/memory-mcp-1file:/project:ro",
                "memory-mcp:fast"
            ],
            "enabled": false
        },
        "memory-mcp-dev-http": {
            "type": "remote",
            "url": "http://localhost:8080/mcp",
            "enabled": true
        },
        "memory-mcp-test": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "--init",
                "--rm",
                "-i",
                "--name",
                "memory-mcp-test",
                "-v",
                "memory-mcp-data-test:/data",
                "-v",
                "/home/unnamed/project/memory-mcp-1file:/project:ro",
                "-e",
                "RECONNECT_TIMEOUT=60",
                "ghcr.io/pomazanbohdan/memory-mcp-1file:latest"
            ],
            "enabled": false
        }
    }
}